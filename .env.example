# =============================================================================
# Election Voting System — Environment Reference
# =============================================================================
#
# For production (GitHub Pages / Docker):
#   Contract addresses are injected via GitHub Secrets in CI/CD.
#   See .github/workflows/ci-cd.yml
#
# For local development:
#   Copy to .env.development and fill in your Hardhat-deployed addresses.
#   CRA loads:  .env  →  .env.{NODE_ENV}  →  .env.{NODE_ENV}.local
#
# Committed env files:
#   .env.test            = Sepolia overrides (chain ID)
#   .env.production      = Mainnet overrides (chain ID)
# =============================================================================

# Contract addresses (set per-environment)
# Final (non-upgradeable) ElectionsManager
REACT_APP_CONTRACT_ADDRESS=0x25b01d643490c71261b0B169eED0BE5C8499805f
# Upgradeable (UUPS proxy) ElectionsManager — used by /upgradeable/* routes
REACT_APP_UPGRADEABLE_CONTRACT_ADDRESS=
REACT_APP_TOKEN_MANAGER_ADDRESS=0x0B2362B683e930fBCe6AE1a0d197f76190110f87
REACT_APP_VOTING_PAYMASTER_ADDRESS=0xE2778De84E3741b1b610Ba6992424fF6bACB96bf
REACT_APP_SECRET_BALLOT_MANAGER_ADDRESS=0xcAA6517e3f539BA678832adBe19c96A9b6D90Bb0
REACT_APP_FRANCHISE_MANAGER_ADDRESS=0x935D97c524Ffa05565e4B7E649a54a9fE4DBb9C1
REACT_APP_VOTING_READER_ADDRESS=0xcb63597472600DfA3F6b339e3fda0FF7833d9aC3

# Network — default to Sepolia testnet
REACT_APP_CHAIN_ID=11155111
# Only needed for local Hardhat development (leave empty for Sepolia/Mainnet):
REACT_APP_HARDHAT_RPC=
REACT_APP_HARDHAT_ACCOUNTS=

# IPFS gateway (include trailing /ipfs/)
REACT_APP_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Upgradeable contract version for /upgradeable/* routes: 1 | 2
# Final (non-upgradeable) is always available on /admin, /voter, /results.
# Set to 1 (V1 core) or 2 (V2 + categories, weights, pause, etc.)
# when an upgradeable proxy is deployed.
REACT_APP_CONTRACT_VERSION=1

# Auto-refresh interval in ms (0 = disabled, 15000 recommended for Sepolia)
REACT_APP_REFRESH_INTERVAL=15000
