# =============================================================================
# Environment Configuration for Election Voting System Frontend
# =============================================================================
# Copy this file to .env.local and fill in the values for your deployment.

# Contract addresses (deployed on your target network)
REACT_APP_CONTRACT_ADDRESS=0x...ElectionsManager
REACT_APP_TOKEN_MANAGER_ADDRESS=0x...TokenManager
REACT_APP_VOTING_PAYMASTER_ADDRESS=0x...VotingPaymaster
REACT_APP_SECRET_BALLOT_MANAGER_ADDRESS=0x...SecretBallotManager
REACT_APP_FRANCHISE_MANAGER_ADDRESS=0x...FranchiseManager

# Network
REACT_APP_CHAIN_ID=31337
REACT_APP_HARDHAT_RPC=http://127.0.0.1:8545

# Hardhat test accounts (local dev only — DO NOT use on real networks)
# JSON array of {name, key, address} objects
REACT_APP_HARDHAT_ACCOUNTS=[]

# UI refresh interval in milliseconds (0 = disabled)
REACT_APP_REFRESH_INTERVAL=0
