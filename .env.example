# =============================================================================
# Election Voting System — Environment Reference
# =============================================================================
#
# Copy to .env (base defaults) and .env.development (local addresses).
# CRA loads:  .env  →  .env.{NODE_ENV}  →  .env.{NODE_ENV}.local
#
# .env                 = Base (always loaded, gitignored)
# .env.development     = Local Hardhat addresses (gitignored)
# .env.test            = Sepolia overrides (committed)
# .env.production      = Mainnet overrides (committed)
# =============================================================================

# Contract addresses (set per-environment)
# Final (non-upgradeable) ElectionsManager
REACT_APP_CONTRACT_ADDRESS=
# Upgradeable (UUPS proxy) ElectionsManager — used by /upgradeable/* routes
REACT_APP_UPGRADEABLE_CONTRACT_ADDRESS=
REACT_APP_TOKEN_MANAGER_ADDRESS=
REACT_APP_VOTING_PAYMASTER_ADDRESS=
REACT_APP_SECRET_BALLOT_MANAGER_ADDRESS=
REACT_APP_FRANCHISE_MANAGER_ADDRESS=
REACT_APP_VOTING_READER_ADDRESS=

# Network
REACT_APP_CHAIN_ID=31337
REACT_APP_HARDHAT_RPC=http://127.0.0.1:8545
REACT_APP_HARDHAT_ACCOUNTS=

# IPFS gateway (include trailing /ipfs/)
REACT_APP_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Upgradeable contract version for /upgradeable/* routes: 1 | 2
# Final (non-upgradeable) is always available on /admin, /voter, /results.
# Set to 1 (V1 core) or 2 (V2 + categories, weights, pause, etc.)
# when an upgradeable proxy is deployed.
REACT_APP_CONTRACT_VERSION=1

# Auto-refresh interval in ms (0 = disabled)
REACT_APP_REFRESH_INTERVAL=0
